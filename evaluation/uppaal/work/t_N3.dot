  L4 -> L6 [label="p2\nx0 := 0"];
  L4 -> L8 [label="x2 > 5 && x1 > 5: any"];
  L4 -> L10 [label="x2 > 5: p1|p3|other"];
  L4 -> L12 [label="x2 > 5: p2\nx0 := 0"];
  L6 -> L2 [label="x1 > 5 && x0 > 5: p2|p3|other"];
  L6 -> L4 [label="x0 > 5: p3|other"];
  L6 -> L4 [label="x0 > 5: p1\nx1 := 0"];
  L6 -> L6 [label="other"];
  L6 -> L6 [label="p2\nx0 := 0"];
  L6 -> L6 [label="p1\nx1 := 0"];
  L6 -> L8 [label="x2 > 5 && x1 > 5 && x0 > 5: any"];
  L6 -> L10 [label="x2 > 5 && x0 > 5: p1|p3|other"];
  L6 -> L12 [label="x2 > 5: p1|other"];
  L6 -> L12 [label="x2 > 5: p2\nx0 := 0"];
  L6 -> L14 [label="x2 > 5 && x1 > 5: p1|p2|other"];
  L6 -> L16 [label="x1 > 5: p2|other"];
  L8 -> L8 [label="any"];
  L10 -> L8 [label="x1 > 5: any"];
  L10 -> L10 [label="p1|p3|other"];
  L10 -> L12 [label="p2\nx0 := 0"];
  L12 -> L8 [label="x1 > 5 && x0 > 5: any"];
  L12 -> L10 [label="x0 > 5: p1|p3|other"];
  L12 -> L12 [label="p1|other"];
  L12 -> L12 [label="p2\nx0 := 0"];
  L12 -> L14 [label="x1 > 5: p1|p2|other"];
  L14 -> L8 [label="x0 > 5: any"];
  L14 -> L14 [label="p1|p2|other"];
  L16 -> L2 [label="x0 > 5: p2|p3|other"];
  L16 -> L4 [label="x0 > 5: p1\nx1 := 0"];
  L16 -> L6 [label="p1\nx1 := 0"];
  L16 -> L8 [label="x2 > 5 && x0 > 5: any"];
  L16 -> L14 [label="x2 > 5: p1|p2|other"];
  L16 -> L16 [label="p2|other"];
}
