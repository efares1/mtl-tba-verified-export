digraph TA {
  rankdir=LR;
  node [shape=circle];
  init [shape=point];
  init -> L1;
  L1 [shape=doublecircle, label="L1"];
  L2 [shape=doublecircle, label="L2"];
  L4 [shape=doublecircle, label="L4\nx1 <= 2"];
  L6 [shape=doublecircle, label="L6"];
  L1 -> L2 [label="p"];
  L1 -> L4 [label="other\nx1 := 0"];
  L1 -> L6 [label="other\nx0 := 0"];
  L2 -> L2 [label="any"];
  L4 -> L2 [label="x1 < 2: p"];
  L4 -> L4 [label="x1 < 2: other"];
  L6 -> L2 [label="x0 > 5: any"];
  L6 -> L6 [label="other"];
}
