    <location id="w" x="0" y="0">
      <name>Wait</name>
      <label kind="invariant">y &lt;= 6</label>
    </location>
    <init ref="i"/>
    <transition>
      <source ref="i"/>
      <target ref="w"/>
      <label kind="guard">z &gt; 0</label>
      <label kind="synchronisation">a1!</label>
      <label kind="assignment">y = 0, z = 0</label>
    </transition>
    <transition>
      <source ref="w"/>
      <target ref="i"/>
      <label kind="guard">z &gt; 0 &amp;&amp; y &gt;= 1</label>
      <label kind="synchronisation">b1!</label>
      <label kind="assignment">z = 0</label>
    </transition>
  </template>
  <template>
    <name>C2</name>
    <declaration>clock y;</declaration>
    <location id="i" x="0" y="0">
      <name>Idle</name>
    </location>
    <location id="w" x="0" y="0">
      <name>Wait</name>
