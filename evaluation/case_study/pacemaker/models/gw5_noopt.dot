digraph TA {
  rankdir=LR;
  node [shape=circle];
  init [shape=point];
  init -> L0;
  L0 [shape=circle, label="L0"];
  L2 [shape=doublecircle, label="L2"];
  L4 [shape=doublecircle, label="L4"];
  L6 [shape=doublecircle, label="L6"];
  L8 [shape=doublecircle, label="L8"];
  L10 [shape=doublecircle, label="L10"];
  L12 [shape=doublecircle, label="L12"];
  L0 -> L0 [label="any"];
  L0 -> L2 [label="a1\nx0 := 0"];
  L0 -> L4 [label="a2\nx1 := 0"];
  L0 -> L6 [label="a3\nx2 := 0"];
  L0 -> L8 [label="a4\nx3 := 0"];
  L0 -> L10 [label="a5\nx4 := 0"];
  L2 -> L2 [label="a1|a2|a3|a4|a5|b2|b3|b4|b5|other"];
  L2 -> L12 [label="x0 > 5: any"];
  L4 -> L4 [label="a1|a2|a3|a4|a5|b1|b3|b4|b5|other"];
  L4 -> L12 [label="x1 > 5: any"];
  L6 -> L6 [label="a1|a2|a3|a4|a5|b1|b2|b4|b5|other"];
  L6 -> L12 [label="x2 > 5: any"];
  L8 -> L8 [label="a1|a2|a3|a4|a5|b1|b2|b3|b5|other"];
  L8 -> L12 [label="x3 > 5: any"];
  L10 -> L10 [label="a1|a2|a3|a4|a5|b1|b2|b3|b4|other"];
  L10 -> L12 [label="x4 > 5: any"];
  L12 -> L12 [label="any"];
}
