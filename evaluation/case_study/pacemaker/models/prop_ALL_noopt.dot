digraph TA {
  rankdir=LR;
  node [shape=circle];
  init [shape=point];
  init -> L0;
  L0 [shape=circle, label="L0"];
  L2 [shape=doublecircle, label="L2"];
  L4 [shape=doublecircle, label="L4"];
  L6 [shape=doublecircle, label="L6\nx2 <= 24"];
  L8 [shape=doublecircle, label="L8\nx3 <= 3"];
  L10 [shape=doublecircle, label="L10"];
  L0 -> L0 [label="any\nx2, x3 := 0"];
  L0 -> L2 [label="apc|asn\nx0, x2, x3 := 0"];
  L0 -> L4 [label="vpc|vsn\nx1, x2, x3 := 0"];
  L0 -> L6 [label="vpc|vsn\nx2, x3 := 0"];
  L0 -> L8 [label="asn\nx2, x3 := 0"];
  L2 -> L2 [label="apc|asn|other\nx2, x3 := 0"];
  L2 -> L10 [label="x0 > 15: any\nx2, x3 := 0"];
  L4 -> L4 [label="vpc|vsn|other\nx2, x3 := 0"];
  L4 -> L10 [label="x1 > 50: any\nx2, x3 := 0"];
  L6 -> L6 [label="x2 < 24: apc|asn|other\nx3 := 0"];
  L6 -> L10 [label="x2 < 24: vpc|vsn\nx2, x3 := 0"];
  L8 -> L8 [label="x3 <= 3: asn|vpc|vsn|other\nx2 := 0"];
  L8 -> L10 [label="x3 <= 3: apc\nx2, x3 := 0"];
  L10 -> L10 [label="any\nx2, x3 := 0"];
}
