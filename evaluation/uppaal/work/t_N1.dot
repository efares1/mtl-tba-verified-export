digraph TA {
  rankdir=LR;
  node [shape=circle];
  init [shape=point];
  init -> L1;
  L1 [shape=doublecircle, label="L1"];
  L2 [shape=doublecircle, label="L2"];
  L4 [shape=doublecircle, label="L4"];
  L1 -> L2 [label="other\nx0 := 0"];
  L2 -> L2 [label="other"];
  L2 -> L4 [label="x0 > 5: any"];
  L4 -> L4 [label="any"];
}
