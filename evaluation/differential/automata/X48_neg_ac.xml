    <transition>
      <source ref="id6"/>
      <target ref="id3"/>
      <label kind="guard">x0 &lt; 2</label>
      <label kind="synchronisation">other?</label>
    </transition>
    <transition>
      <source ref="id7"/>
      <target ref="id3"/>
