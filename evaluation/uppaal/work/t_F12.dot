digraph TA {
  rankdir=LR;
  node [shape=circle];
  init [shape=point];
  init -> L0;
  L0 [shape=circle, label="L0"];
  L2 [shape=doublecircle, label="L2"];
  L4 [shape=doublecircle, label="L4\nx1 <= 2"];
  L6 [shape=doublecircle, label="L6"];
  L0 -> L0 [label="any\nx1 := 0"];
  L0 -> L4 [label="p\nx1 := 0"];
  L0 -> L6 [label="p\nx0 := 0"];
  L2 -> L2 [label="any"];
  L4 -> L2 [label="x1 < 2: q"];
  L4 -> L4 [label="x1 < 2: p|other"];
  L6 -> L2 [label="x0 > 5: any"];
  L6 -> L6 [label="p|other"];
}
