digraph TA {
  rankdir=LR;
  node [shape=circle];
  init [shape=point];
  init -> L1;
  L1 [shape=doublecircle, label="L1"];
  L2 [shape=doublecircle, label="L2"];
  L4 [shape=doublecircle, label="L4\nx0 <= 3"];
  L6 [shape=doublecircle, label="L6"];
  L8 [shape=doublecircle, label="L8"];
  L10 [shape=doublecircle, label="L10\nx0 <= 3"];
  L12 [shape=doublecircle, label="L12"];
  L1 -> L2 [label="other\nx0, x2 := 0"];
  L1 -> L4 [label="p\nx0, x2 := 0"];
  L1 -> L6 [label="p\nx0, x1, x2 := 0"];
  L2 -> L2 [label="other\nx0 := 0"];
  L2 -> L4 [label="p\nx0 := 0"];
  L2 -> L6 [label="p\nx0, x1 := 0"];
  L2 -> L8 [label="x2 > 5: any"];
  L4 -> L2 [label="x0 <= 3: other\nx0 := 0"];
  L4 -> L4 [label="x0 <= 3: p"];
  L4 -> L8 [label="x2 > 5 && x0 <= 3: other"];
  L4 -> L10 [label="x2 > 5 && x0 <= 3: p|q"];
  L6 -> L2 [label="other\nx0 := 0"];
  L6 -> L4 [label="p\nx0 := 0"];
  L6 -> L6 [label="p\nx0, x1 := 0"];
  L6 -> L8 [label="x2 > 5: other\nx2 > 5 && x1 > 2: any"];
  L6 -> L10 [label="x2 > 5: p\nx0 := 0"];
  L6 -> L12 [label="x2 > 5: p\nx0 := 0"];
  L8 -> L8 [label="any"];
  L10 -> L8 [label="x0 <= 3: other"];
  L10 -> L10 [label="x0 <= 3: p|q"];
  L12 -> L8 [label="other\nx1 > 2: any"];
  L12 -> L10 [label="p\nx0 := 0"];
  L12 -> L12 [label="p\nx0 := 0"];
}
