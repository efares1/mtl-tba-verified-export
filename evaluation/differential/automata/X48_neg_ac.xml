      <source ref="id12"/>
      <target ref="id12"/>
      <label kind="guard">x1 &lt; 3</label>
      <label kind="synchronisation">r?</label>
      <label kind="assignment">x0 = 0</label>
    </transition>
    <transition>
      <source ref="id12"/>
      <target ref="id9"/>
      <label kind="guard">x1 &lt; 3</label>
      <label kind="synchronisation">r?</label>
