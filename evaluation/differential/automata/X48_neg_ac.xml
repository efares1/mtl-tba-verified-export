    <transition>
      <source ref="id9"/>
      <target ref="id3"/>
      <label kind="guard">x0 &lt; 2</label>
      <label kind="synchronisation">other?</label>
    </transition>
    <transition>
      <source ref="id6"/>
      <target ref="id12"/>
      <label kind="guard">x1 &lt; 3</label>
      <label kind="synchronisation">r?</label>
      <label kind="assignment">x0 = 0</label>
    </transition>
    <transition>
      <source ref="id7"/>
      <target ref="id12"/>
      <label kind="guard">x1 &lt; 3</label>
      <label kind="synchronisation">r?</label>
      <label kind="assignment">x0 = 0</label>
    </transition>
    <transition>
      <source ref="id6"/>
      <target ref="id9"/>
      <label kind="guard">x1 &lt; 3</label>
      <label kind="synchronisation">r?</label>
      <label kind="assignment">x0 = 0</label>
    </transition>
    <transition>
      <source ref="id7"/>
      <target ref="id9"/>
      <label kind="guard">x1 &lt; 3</label>
      <label kind="synchronisation">r?</label>
      <label kind="assignment">x0 = 0</label>
    </transition>
    <transition>
      <source ref="id6"/>
      <target ref="id9"/>
      <label kind="guard">x0 &lt; 2</label>
      <label kind="synchronisation">r?</label>
    </transition>
    <transition>
      <source ref="id7"/>
